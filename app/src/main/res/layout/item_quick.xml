<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_quick_card"
    android:foreground="@drawable/row_selector"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/quickArt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_art_rounded_sm"
        android:contentDescription="Album art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_note" />

    <TextView
        android:id="@+id/quickTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/spotify_white"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
