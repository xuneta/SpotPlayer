<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:id="@+id/npBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/spotify_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/npClose"
                android:background="@drawable/bg_soft_circle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Close"
                android:padding="3dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/spotify_white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="PLAYING FROM LIBRARY"
                    android:textColor="@color/spotify_gray"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/npAlbum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/spotify_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/npQueueBtn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_soft_circle"
                    android:contentDescription="Queue"
                    android:padding="4dp"
                    android:src="@drawable/ic_queue"
                    android:tint="@color/spotify_white" />

                <ImageView
                    android:id="@+id/npSleepBtn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_soft_circle"
                    android:contentDescription="Sleep timer"
                    android:padding="5dp"
                    android:src="@drawable/ic_moon"
                    android:tint="@color/spotify_gray" />

                <ImageView
                    android:id="@+id/npCarBtn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_soft_circle"
                    android:contentDescription="Car mode"
                    android:padding="5dp"
                    android:src="@drawable/ic_car"
                    android:tint="@color/spotify_gray" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/npArt"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_art_rounded"
            android:contentDescription="Album art"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_note" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/npTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/spotify_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/npArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/spotify_gray"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/npStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="☆☆☆☆☆"
                    android:textColor="@color/spotify_gray"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/npQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/spotify_gray"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/npLike"
                android:padding="2dp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="14dp"
                android:contentDescription="Like"
                android:src="@drawable/ic_heart_outline" />
        </LinearLayout>

        <com.arman.spotplayer.WaveformView
            android:id="@+id/npWave"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/npSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressDrawable="@drawable/seek_np"
            android:thumb="@drawable/thumb_white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/npPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/spotify_gray"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/npDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/spotify_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/npShuffle"
                    android:padding="5dp"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Shuffle"
                    android:src="@drawable/ic_shuffle" />

                <View
                    android:id="@+id/npShuffleDot"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_dot_green"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/npPrev"
                    android:padding="4dp"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:contentDescription="Previous"
                    android:src="@drawable/ic_prev"
                    android:tint="@color/spotify_white" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/npPlayBtn"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_white">

                <ImageView
                    android:id="@+id/npPlayIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="Play or pause"
                    android:src="@drawable/ic_play"
                    android:tint="#121212" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/npNext"
                    android:padding="4dp"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:contentDescription="Next"
                    android:src="@drawable/ic_next"
                    android:tint="@color/spotify_white" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/npRepeatBtn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/npRepeat"
                    android:padding="5dp"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Repeat"
                    android:src="@drawable/ic_repeat" />

                <TextView
                    android:id="@+id/npRepeatBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="10dp"
                    android:text="1"
                    android:textColor="@color/spotify_green"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <View
                    android:id="@+id/npRepeatDot"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_dot_green"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/npLyricsBtn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Lyrics"
                android:padding="2dp"
                android:src="@drawable/ic_lyrics"
                android:tint="@color/spotify_gray" />

            <TextView
                android:id="@+id/npSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_sort_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="1×"
                android:textColor="@color/spotify_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/npAb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_sort_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="A–B"
                android:textColor="@color/spotify_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/npShareBtn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Share"
                android:padding="2dp"
                android:src="@drawable/ic_share"
                android:tint="@color/spotify_gray" />
        </LinearLayout>

        <TextView
            android:id="@+id/npNextUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/spotify_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/npBigHeart"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="188dp"
        android:alpha="0"
        android:contentDescription="Liked"
        android:src="@drawable/ic_heart_filled"
        android:visibility="gone" />
</FrameLayout>
