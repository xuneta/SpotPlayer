<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widgetArt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/auto_album_art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/auto_spotplayer"
            android:textColor="@color/spotify_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/auto_pick_a_song"
            android:textColor="@color/spotify_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widgetPrev"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/auto_previous"
        android:padding="12dp"
        android:src="@drawable/ic_prev" />

    <ImageView
        android:id="@+id/widgetPlayIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/auto_play_or_pause"
        android:padding="9dp"
        android:src="@drawable/ic_play" />

    <ImageView
        android:id="@+id/widgetNext"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/auto_next"
        android:padding="12dp"
        android:src="@drawable/ic_next" />
</LinearLayout>
